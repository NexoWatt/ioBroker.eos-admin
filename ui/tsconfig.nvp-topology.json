{
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src-ts/runtime-executables/ems/services/nvp-*.ts",
    "src-ts/runtime-executables/ems/modules/nvp-topology.ts",
    "src-ts/runtime-executables/lib/nvp-config-api.ts",
    "src-ts/runtime-executables/ems/services/dynamic-grid-*.ts",
    "src-ts/runtime-executables/ems/modules/dynamic-grid-connection.ts",
    "src-ts/runtime-executables/lib/dynamic-grid-config-api.ts"
  ]
}
