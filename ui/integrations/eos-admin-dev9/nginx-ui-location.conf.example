# NexoWatt UI 1.0.37 / EOS dev9: Fragment innerhalb eines bereits eingerichteten
# HTTPS-server-Blocks. Kein vollständiger Server und keine automatische Installation.
# Beispiel für UI-Instanz 0 und lokalen Adapterport 8188. Bei öffentlichem Admin-
# Präfix /admin/ sowohl location als auch X-Forwarded-Prefix um /admin ergänzen.
# Herkunftsheader werden hier überschrieben, nicht vom Browser übernommen.
location /proxy/nexowatt-ui.0/ {
    proxy_pass http://127.0.0.1:8188/;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Prefix /proxy/nexowatt-ui.0;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 75s;
    proxy_send_timeout 15s;
}
