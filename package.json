  "scripts": {
    "start": "cd src-admin && npm run start",
    "build": "npm run build:frontend && npm run build:installer && npm run build:unified-backend && npm run build:ui-runtime",
    "build:backend": "tsc -p tsconfig.build.json && node --import tsx tasks.mts --backend-i18n",
    "build:frontend": "node --import tsx tasks.mts",
    "build:unified-backend": "tsc -p tsconfig.build.json && node --import tsx tasks.mts --backend-i18n",
    "build:ui-runtime": "node ui/scripts/build-ts-runtime-executables.js",
    "lint-backend": "eslint -c eslint.config.mjs src",
    "lint": "npm run lint-backend && cd src-admin && npm run lint",
    "test:unified": "node --test test/eos-unified*.test.cjs test/eos-hosted-boundary-http.test.cjs test/eos-license*.test.cjs ui/test/unified/*.test.cjs test/eos-access-diagnostics.test.cjs test/eos-ingress-renderer.test.cjs test/eos-sbom-vendored.test.cjs",
    "check:unified": "node tools/eos-release-check.cjs",
    "seal:unified": "node tools/eos-release-manifest.cjs --write",
    "prepack": "node tools/eos-release-check.cjs",
    "prepublishOnly": "node tools/eos-release-check.cjs && npm run test:unified",
    "test:unit": "npm run test:unified",
    "test": "npm run test:unified && npm run test:retained",
    "test:retained": "node --test test/eos-session-security.test.cjs test/eos-web-resources.test.cjs test/eos-auth-regressions.test.cjs",
    "test:package": "node --test test/eos-unified-metadata.test.cjs",
    "test:integration": "mocha test/integration-unified.cjs --exit",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "build:installer": "npm --prefix ui/src-admin-tab run build",
    "sbom": "npm sbom --sbom-format=cyclonedx > release-manifests/unified/build-environment.cdx.json && node tools/eos-sbom-vendored.cjs",
    "lint:unified": "eslint -c eslint.unified.config.mjs src/lib/eosUnifiedBoundary.js src/lib/eosUnifiedOwnership.js src/lib/eosLicenseCore.js src/lib/eosLicensePolicy.js src/lib/eosLicenseService.js src/lib/eosLicenseHttp.js tools/eos-release-check.cjs tools/eos-release-manifest.cjs tools/eos-migration-plan.cjs tools/eos-access-diagnostics.cjs deploy/render-ingress.cjs tools/eos-sbom-vendored.cjs"
  },
