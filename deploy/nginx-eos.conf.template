# NexoWatt EOS 9.0.0-alpha.1 — inside nginx's http {} context.
# Generate with render-ingress.cjs; certificate and key are never shipped.
# Runtime adapter: native.bind=127.0.0.1, native.port=8188, native.secure=false,
# native.eosExternalOrigin=https://@@DEVICE_IP@@

map $http_upgrade $eos_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name @@DEVICE_IP@@;

    # Pin the origin. Never derive a redirect or upstream host from client data.
    if ($host != "@@DEVICE_IP@@") { return 421; }

    ssl_certificate @@CERTIFICATE@@;
    ssl_certificate_key @@PRIVATE_KEY@@;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    server_tokens off;
    client_max_body_size 16m;
    client_body_timeout 15s;
    client_header_timeout 15s;
    keepalive_timeout 30s;

    # Do not log bearer tokens, query parameters or activation data.
    access_log off;
    error_log /var/log/nginx/nexowatt-eos-error.log warn;

    location / {
        proxy_pass http://127.0.0.1:8188;
        proxy_http_version 1.1;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 75s;
        proxy_buffering off;
        proxy_cache off;
        proxy_redirect off;

        # Explicit allowlist strips client identity and forwarding headers.
        # These headers convey transport/browser inputs, never a trusted role.
        proxy_pass_request_headers off;
        proxy_set_header Host "@@DEVICE_IP@@";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Content-Type $http_content_type;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Origin $http_origin;
        proxy_set_header Accept $http_accept;
        proxy_set_header Accept-Language $http_accept_language;
        proxy_set_header User-Agent $http_user_agent;
        proxy_set_header Sec-Fetch-Site $http_sec_fetch_site;
        proxy_set_header Sec-Fetch-Mode $http_sec_fetch_mode;
        proxy_set_header X-Requested-With $http_x_requested_with;
        proxy_set_header X-NW-CSRF $http_x_nw_csrf;
        proxy_set_header X-EOS-License $http_x_eos_license;
        proxy_set_header X-NexoWatt-EOS-First-Login $http_x_nexowatt_eos_first_login;
        proxy_set_header X-NexoWatt-EOS-Account-Reset $http_x_nexowatt_eos_account_reset;
        proxy_set_header X-NexoWatt-EOS-Auto-Update $http_x_nexowatt_eos_auto_update;
        proxy_set_header X-NexoWatt-EOS-Role-Settings $http_x_nexowatt_eos_role_settings;
        proxy_set_header X-Mesh-Token $http_x_mesh_token;
        proxy_set_header X-NexoWatt-Mesh-Token $http_x_nexowatt_mesh_token;
        proxy_set_header Last-Event-ID $http_last_event_id;
        proxy_set_header If-None-Match $http_if_none_match;
        proxy_set_header If-Modified-Since $http_if_modified_since;
        proxy_set_header Range $http_range;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $eos_connection_upgrade;
        proxy_set_header Sec-WebSocket-Key $http_sec_websocket_key;
        proxy_set_header Sec-WebSocket-Version $http_sec_websocket_version;
        proxy_set_header Sec-WebSocket-Protocol $http_sec_websocket_protocol;
        proxy_set_header Sec-WebSocket-Extensions $http_sec_websocket_extensions;
    }
}

