    "r.minPowerSetpointW": "Minimum admissible signed active-power target (charge is negative)",
    "r.maxPowerSetpointW": "Maximum admissible signed active-power target (discharge is positive)",
    "r.powerSetpointReadbackW": "Device-read active-power target (not measured physical delivery)",
    "r.pvPowerDc": "PV generation measured on DC side",
    "r.pvPowerAc": "PV generation measured on AC side",
    "r.pvPowerTotal": "Device reported total PV generation (do not add AC/DC values again)"
  },
