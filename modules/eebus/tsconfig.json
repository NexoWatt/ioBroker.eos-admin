{
  "compilerOptions": {
    "outDir": "build", "rootDir": "src", "module": "Node16",
    "moduleResolution": "Node16", "target": "ES2022", "lib": ["ES2022"],
    "esModuleInterop": true, "skipLibCheck": true, "strict": true,
    "noEmitOnError": true, "types": ["node", "@iobroker/types"]
  },
  "include": ["src/**/*.ts"]
}
